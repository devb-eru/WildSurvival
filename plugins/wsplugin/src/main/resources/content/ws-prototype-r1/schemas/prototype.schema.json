{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wildsurvival.local/schema/prototype.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "contentRevision", "runType", "promotionForbidden", "minimumPlayers", "maximumPlayers",
    "dayCheckpoints", "progressExpByDay", "resources", "items", "recipes", "weapons", "skills", "enemies",
    "personalAugments", "partyAugments", "boss"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "contentRevision": {"const": "ws-prototype-r1"},
    "runType": {"const": "PROTOTYPE"},
    "promotionForbidden": {"const": true},
    "minimumPlayers": {"const": 2},
    "maximumPlayers": {"const": 4},
    "dayCheckpoints": {"const": [1, 3, 6, 10]},
    "progressExpByDay": {"type": "object"},
    "resources": {"type": "array", "minItems": 4},
    "items": {"type": "array", "minItems": 10},
    "recipes": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "costs", "shape", "shapeless", "rewardType", "rewardId", "rewardAmount"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "costs": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 1}},
          "shape": {
            "type": "array",
            "minItems": 9,
            "maxItems": 9,
            "items": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}
          },
          "shapeless": {"type": "boolean"},
          "rewardType": {"enum": ["EQUIPMENT", "ITEM", "QUICK_ITEM", "FACILITY"]},
          "rewardId": {"type": "string", "minLength": 1},
          "rewardAmount": {"type": "integer", "minimum": 1}
        }
      }
    },
    "weapons": {"type": "array", "minItems": 5},
    "skills": {"type": "array", "minItems": 12},
    "enemies": {"type": "array", "minItems": 4},
    "personalAugments": {"type": "array", "minItems": 9},
    "partyAugments": {"type": "array", "minItems": 3},
    "boss": {"type": "object"}
  }
}
