{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contentRevision",
    "domain",
    "records"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "contentRevision": {
      "const": "ws-content-r2.1"
    },
    "domain": {
      "const": "research"
    },
    "records": {
      "type": "array",
      "minItems": 25,
      "maxItems": 25,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "costId",
          "sourceDocumentId",
          "enabled",
          "minimumDay",
          "prerequisiteText",
          "comparisonInput",
          "cost",
          "durationSeconds",
          "unlockText",
          "stateMachine",
          "raw"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^RS-"
          },
          "costId": {
            "type": "string",
            "pattern": "^RCOST-RS-"
          },
          "sourceDocumentId": {
            "const": "RESEARCH-001"
          },
          "enabled": {
            "const": true
          },
          "minimumDay": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "prerequisiteText": {
            "type": "string",
            "minLength": 1
          },
          "comparisonInput": {
            "type": "string",
            "minLength": 1
          },
          "durationSeconds": {
            "type": "integer",
            "minimum": 1
          },
          "unlockText": {
            "type": "string",
            "minLength": 1
          },
          "cost": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "general",
              "metal",
              "signal",
              "specialist"
            ],
            "properties": {
              "general": {
                "type": "integer",
                "minimum": 0
              },
              "metal": {
                "type": "integer",
                "minimum": 0
              },
              "signal": {
                "type": "integer",
                "minimum": 0
              },
              "specialist": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "stateMachine": {
            "type": "array",
            "minItems": 10,
            "maxItems": 10,
            "items": {
              "type": "string"
            }
          },
          "raw": {
            "type": "array",
            "minItems": 5,
            "maxItems": 5,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
