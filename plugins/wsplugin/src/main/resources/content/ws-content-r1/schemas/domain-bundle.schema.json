{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wildsurvival.local/schema/domain-bundle-v1.json",
  "title": "WildSurvival domain bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contentRevision", "domain", "dataRevision", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contentRevision": { "type": "string", "pattern": "^ws-content-r[0-9]+$" },
    "domain": {
      "type": "string",
      "enum": ["days", "encounters", "resources", "equipment", "enemies", "bosses", "admin-commands"]
    },
    "dataRevision": { "type": "string", "minLength": 3 },
    "entries": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "metadata": { "type": "object" }
  }
}
