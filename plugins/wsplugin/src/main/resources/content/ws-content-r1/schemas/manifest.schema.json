{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wildsurvival.local/schema/content-manifest-v1.json",
  "title": "WildSurvival content manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contentRevision", "activation", "storyRevision", "files"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contentRevision": { "type": "string", "pattern": "^ws-content-r[0-9]+$" },
    "activation": { "const": "NEW_RUN_ONLY" },
    "storyRevision": { "type": "string" },
    "createdAt": { "type": "string", "format": "date" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "domain", "schemaVersion", "sha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^[a-z0-9_./-]+\\.json$" },
          "domain": { "type": "string" },
          "schemaVersion": { "const": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
