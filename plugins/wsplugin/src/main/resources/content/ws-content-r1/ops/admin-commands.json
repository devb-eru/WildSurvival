    {"id":"CMD-INSPECT-FACILITY","path":"admin inspect facility","permission":"wildsurvival.admin.inspect","mutation":false,"args":["facilityInstanceId"],"result":"FACILITY_NETWORK_JOB_CORRUPTION"},
