{
  "schemaVersion": 1,
  "contentRevision": "ws-content-r1",
  "domain": "admin-commands",
  "dataRevision": "admin-command-r1",
  "metadata": {
    "rootCommand":"wildsurvival",
    "aliases":["ws"],
    "consoleAllowed":true,
    "mutationsRequireReason":true,
    "mutationsRequireDryRunToken":true,
    "auditTable":"admin_audit",
