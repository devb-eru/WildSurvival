    {"id":"CMD-INSPECT-RUN","path":"admin inspect run","permission":"wildsurvival.admin.inspect","mutation":false,"args":["runId?"],"result":"RUN_DAY_MEMBERS_REVISION_STATE"},
    {"id":"CMD-INSPECT-PLAYER","path":"admin inspect player","permission":"wildsurvival.admin.inspect","mutation":false,"args":["player","runId?"],"result":"LIFE_EQUIPMENT_AUGMENT_DISCOVERY_TX"},
