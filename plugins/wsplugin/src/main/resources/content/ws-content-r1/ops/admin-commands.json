    {"id":"CMD-MIGRATE-APPLY","path":"admin migrate apply","permission":"wildsurvival.admin.migrate","mutation":true,"args":["planId","reason"],"dryRun":true,"confirmationToken":true,"precondition":"NO_ACTIVE_COMBAT_AND_BACKUP_EXISTS"},
    {"id":"CMD-AUDIT-QUERY","path":"admin audit query","permission":"wildsurvival.admin.audit","mutation":false,"args":["runId?","actor?","since?","limit?"],"result":"REDACTED_AUDIT_ROWS"}
