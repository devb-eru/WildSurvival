    {"id":"CMD-RECOVER-ITEM","path":"admin recover item","permission":"wildsurvival.admin.recover.item","mutation":true,"args":["itemInstanceId","mode=QUARANTINE|RESTORE_LEDGER_COPY","reason"],"dryRun":true,"confirmationToken":true,"precondition":"SIGNATURE_AND_LEDGER_AUDIT"},
    {"id":"CMD-RECOVER-ENCOUNTER","path":"admin recover encounter","permission":"wildsurvival.admin.recover.encounter","mutation":true,"args":["encounterId","mode=RESUME|SAFE_CANCEL|ROLLBACK_CALL","reason"],"dryRun":true,"confirmationToken":true,"precondition":"NO_COMMITTED_REWARD_FOR_CANCEL"},
    {"id":"CMD-RECOVER-REWARD","path":"admin recover reward","permission":"wildsurvival.admin.recover.reward","mutation":true,"args":["rewardId","mode=RESUME_MISSING_STAGES","reason"],"dryRun":true,"confirmationToken":true,"precondition":"SOURCE_RESULT_COMMITTED"},
